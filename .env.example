# Copy to .env and edit. Consumed by docker-compose and by Martin's config.yaml.
#
# Local (Postgres.app on the same Mac, from a native Martin process):
#   DATABASE_URL=postgresql://aidianholder@localhost:5432/crashes
#
# From a Docker container reaching a DB on the host Mac/PC, use the special host:
#   DATABASE_URL=postgresql://aidianholder@host.docker.internal:5432/crashes
#
# Production (DB on the Linux server or a managed instance):
#   DATABASE_URL=postgresql://crashes_ro:CHANGE_ME@db-host:5432/crashes?sslmode=require
DATABASE_URL=postgresql://aidianholder@host.docker.internal:5432/crashes
